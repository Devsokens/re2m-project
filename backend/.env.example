# Supabase project settings (Project Settings > API in the Supabase dashboard)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_ANON_KEY=eyJ...

# Storage bucket used for all uploaded images (member photos, CMS images, logos, stamp, covers)
SUPABASE_STORAGE_BUCKET=public-assets

# Comma-separated list of origins allowed to call this API (your Vercel frontend URL + localhost for dev)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-frontend.vercel.app

# Port Render (or your local machine) should run the server on
PORT=4000
